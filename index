  .avatar-badge:hover,.avatar-badge:focus{min-height:40px;height:auto}
}
@media(max-width:700px){
  .md{padding:20px 16px 28px}
  .two{grid-template-columns:1fr}
  .anchor{display:none}
}
</style>
