<style>
:root{
  --fg:#eef1e8; --muted:#b9c1ad; --line:#5e6857; --soft:#394033;
  --green:#a7d98f; --green-2:#a7d98f; --green-bg:rgba(167,217,143,.16); --green-line:rgba(167,217,143,.42); --green-ink:#d2f0c3;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans",Helvetica,Arial,sans-serif;
  --mono:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,"Liberation Mono",monospace;
  --bg:#42493d; --offline:#8c959f; --hover:#4d5646; --on-green:#1d2a16; --shadow:rgba(18,22,15,.6);
  color-scheme:dark;
}
*,*::before,*::after{box-sizing:border-box}
[hidden]{display:none!important}
html{scroll-behavior:smooth;scroll-padding-top:16px}
body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.5 var(--sans);-webkit-text-size-adjust:100%}
a:focus-visible{outline:2px solid var(--green-2);outline-offset:2px;border-radius:3px}

.page{max-width:1216px;margin:0 auto;padding:calc(32px + env(safe-area-inset-top,0px)) 16px calc(48px + env(safe-area-inset-bottom,0px));display:grid;grid-template-columns:296px minmax(0,1fr);gap:32px;align-items:start}
.box{border:1px solid var(--line);border-radius:6px;background:var(--bg);overflow:hidden}
.box-head{display:flex;align-items:center;gap:8px;padding:10px 16px;background:var(--soft);border-bottom:1px solid var(--line);font-size:.875rem;font-weight:600}
.box-head>svg{fill:var(--muted);flex:none}

/* ---------- markdown-ish content ---------- */
.md{padding:32px 40px 40px}
.md>*:first-child{margin-top:0}
.md h1,.md h2{font-weight:600;line-height:1.25;padding-bottom:.3em;border-bottom:1px solid var(--line)}
.md h1{font-size:2em;margin:0 0 20px}
.md h2{font-size:1.5em;margin:32px 0 16px;position:relative}
.md h3{font-size:1.25em;font-weight:600;line-height:1.25;margin:24px 0 12px}
.md p{margin:0 0 16px}
.md a{color:var(--green);text-decoration:none}
.md a:hover{text-decoration:underline}
.md ul{padding-left:2em;margin:0 0 16px}
.md li+li{margin-top:.25em}
.md ul.plain{list-style:none;padding:0}
.anchor{position:absolute;left:-1.4em;top:0;width:1.2em;color:var(--muted)!important;font-weight:400;opacity:0;text-decoration:none!important}
.md h2:hover .anchor,.anchor:focus-visible{opacity:1}
.muted{color:var(--muted)}

/* ---------- sidebar (GitHub profile style) ---------- */
.sidecol{min-width:0}
.side{font-size:16px}
.avatar-wrap{position:relative}
.avatar{width:100%;aspect-ratio:1;border-radius:50%;border:1px solid var(--line);overflow:hidden;background:var(--green-bg)}
.avatar img{width:100%;height:100%;object-fit:cover;display:block}
.avatar-badge{position:absolute;left:calc(100% - 40px);bottom:30px;z-index:5;display:flex;align-items:center;height:40px;min-width:40px;border-radius:20px;background:var(--bg);border:1px solid var(--line);color:var(--fg);outline:none;cursor:default;transition:box-shadow .2s}
.avatar-badge:hover,.avatar-badge:focus{box-shadow:0 8px 24px var(--shadow)}
.avatar-badge:focus-visible{outline:2px solid var(--green-2);outline-offset:2px}
.b-icon{width:38px;height:38px;flex:none;display:flex;align-items:center;justify-content:center;font-size:18px;line-height:1}
.b-icon .emoji{width:20px;height:20px}
.b-text{max-width:0;opacity:0;padding:0;overflow:hidden;white-space:nowrap;font-size:14px;font-weight:500;line-height:20px;transition:max-width .22s ease,opacity .15s ease,padding .22s ease}
.avatar-badge:hover .b-text,.avatar-badge:focus .b-text{max-width:min(520px,calc(100vw - 300px));opacity:1;padding:0 16px 0 4px}
@media(prefers-reduced-motion:reduce){.avatar-badge,.b-text{transition:none}}
.dot{--c:var(--green-2);width:8px;height:8px;flex:none;border-radius:50%;background:var(--c)}
.dot.big{width:14px;height:14px}
.dot.idle{--c:#bf8700}.dot.dnd{--c:#cf222e}.dot.offline{--c:var(--offline)}
.names{padding:16px 0 0}
.side h1{font-size:26px;font-weight:600;line-height:1.25;margin:0;padding:0;border:0}
.username{margin:0;font-size:20px;font-weight:300;line-height:24px;color:var(--muted)}
.username a{color:inherit;text-decoration:none;cursor:pointer}
.username a:hover{color:inherit;text-decoration:none}
.emoji{width:16px;height:16px;object-fit:contain;border-radius:3px}
.side .bio{margin:16px 0 0;font-size:16px;line-height:1.5}
.vcard{list-style:none;margin:16px 0 0;padding:0}
.vcard li{display:flex;align-items:flex-start;gap:8px;margin:0 0 4px;line-height:24px;min-width:0}
.vcard svg{flex:none;width:16px;height:16px;margin-top:4px;fill:none;stroke:var(--muted);stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round}
.vcard span,.vcard a{min-width:0;overflow-wrap:anywhere}
.vcard a{color:var(--fg);text-decoration:none}
.vcard a:hover{color:var(--green);text-decoration:underline}
.side .np{max-width:none;margin-top:24px}

/* now playing */
.np{display:flex;gap:12px;align-items:center;width:100%;max-width:380px;padding:10px 12px;border:1px solid var(--line);border-radius:6px;background:var(--soft);color:var(--fg)!important;text-decoration:none!important;line-height:1.3;text-transform:lowercase}
.np:hover{border-color:var(--green-2)}
.np img{width:48px;height:48px;border-radius:6px;object-fit:cover;flex:none;background:var(--green-bg)}
.np .txt{min-width:0}
.np small{display:block;font:600 .75rem var(--sans);color:var(--green)}
.np b,.np i{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.np b{font-weight:600}
.np i{font-style:normal;font-size:.875rem;color:var(--muted)}

/* ---------- tables ---------- */
.tablewrap{overflow-x:auto;margin:0 0 16px}
table{border-collapse:collapse;width:100%}
th,td{padding:6px 13px;border:1px solid var(--line);text-align:left;vertical-align:top}
th{font-weight:600}
tbody tr:nth-child(even){background:var(--soft)}
th[scope=row]{white-space:nowrap;width:1%}
.clock{display:inline-flex;align-items:center;gap:6px;margin-left:8px;padding:.15em .5em;border:1px solid var(--green-line);border-radius:6px;background:var(--green-bg);color:var(--green-ink);font:.85em var(--mono)}

/* ---------- labels ---------- */
.tags{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 16px;padding:0!important;list-style:none}
.tags li{margin:0!important;padding:.2em .55em;border:1px solid var(--green-line);border-radius:6px;background:var(--green-bg);color:var(--green-ink);font:.85rem/1.5 var(--mono)}
.tags li.hl{background:var(--green);border-color:var(--green);color:var(--on-green)}
.tags.dni li{background:var(--soft);border-color:var(--line);color:var(--fg)}

/* ---------- layout bits ---------- */
.two{display:grid;grid-template-columns:1fr 1fr;gap:0 32px}
.two h3{margin-top:0}
.alert{margin:0 0 16px;padding:0 1em;border-left:.25em solid var(--green-2)}
.alert-title{margin:0 0 4px!important;font-weight:600;color:var(--green)}
.alert p:last-child{margin-bottom:0}

@media(max-width:860px){
