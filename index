<script>
(function(){
  /* Local time (Texas / Central) */
  var TZ='America/Chicago';
  var tzName=document.getElementById('tz-name'),tzTime=document.getElementById('tz-time');
  function clock(){
    try{
      var now=new Date();
      var part=function(opts){return new Intl.DateTimeFormat('en-US',Object.assign({timeZone:TZ},opts)).formatToParts(now).filter(function(p){return p.type==='timeZoneName'})[0].value};
      tzName.textContent=(part({timeZoneName:'short'})+' · '+part({timeZoneName:'shortOffset'})).toLowerCase();
      tzTime.textContent=now.toLocaleTimeString('en-US',{timeZone:TZ,hour:'numeric',minute:'2-digit'}).replace(/\u202f/g,' ').toLowerCase();
    }catch(e){}
  }
  clock();
  setInterval(clock,15000);

  /* Discord presence (via Lanyard) */
  var DISCORD_ID='701517787776024647';
  var avatarImg=document.getElementById('avatar-img');
  var bdot=document.getElementById('badge-dot'),bimg=document.getElementById('badge-img'),buni=document.getElementById('badge-uni'),btext=document.getElementById('badge-text'),np=document.getElementById('np');
  function setBadge(uni,emojiSrc,txt,label){
    btext.textContent=txt||label;
    bimg.hidden=!emojiSrc;if(emojiSrc)bimg.src=emojiSrc;else bimg.removeAttribute('src');
    buni.textContent=uni||'';buni.hidden=!uni||!!emojiSrc;
    bdot.hidden=!!(emojiSrc||uni);
  }
  function offline(){bdot.className='dot big offline';setBadge('','','','offline')}
  function presence(){
    fetch('https://api.lanyard.rest/v1/users/'+DISCORD_ID).then(function(r){return r.json()}).then(function(j){
      if(!j.success){offline();return}
      var d=j.data,s=d.discord_status||'offline';
      bdot.className='dot big '+s;
      var act=(d.activities||[]).filter(function(x){return x.type===4})[0];
      var emojiSrc='',uni='',plain='',label=s==='dnd'?'do not disturb':s;
      if(act){
        plain=(act.state||'').toLowerCase();
        var e=act.emoji;
        if(e&&e.id)emojiSrc='https://cdn.discordapp.com/emojis/'+e.id+'.'+(e.animated?'gif':'png')+'?size=48';
        else if(e&&e.name)uni=e.name;
      }
      setBadge(uni,emojiSrc,plain,label);
      var u=d.discord_user;
      if(u&&u.username)document.getElementById('discord-name').textContent='@'+u.username; /* your Discord username; the text in the HTML is the fallback */
      if(u&&u.avatar){
        var ext=u.avatar.indexOf('a_')===0?'gif':'png';
        avatarImg.src='https://cdn.discordapp.com/avatars/'+u.id+'/'+u.avatar+'.'+ext+'?size=1024';
      }
    }).catch(offline);
  }
  presence();
  setInterval(presence,30000);

  /* Last played (via Last.fm) */
  var LASTFM_USER='pissyrager';
  var LASTFM_KEY='d992dbc4011d375c6c12966bd0f00cc9';
  function lastfm(){
    if(LASTFM_KEY.indexOf('YOUR_')===0)return;
    var url='https://ws.audioscrobbler.com/2.0/?method=user.getrecenttracks&limit=1&format=json&user='+encodeURIComponent(LASTFM_USER)+'&api_key='+encodeURIComponent(LASTFM_KEY);
    fetch(url).then(function(r){return r.json()}).then(function(j){
      var t=j.recenttracks&&j.recenttracks.track;
      if(Array.isArray(t))t=t[0];
      if(!t){np.hidden=true;return}
      var live=!!(t['@attr']&&t['@attr'].nowplaying==='true');
      document.getElementById('np-label').textContent=live?'now playing':'last played';
      document.getElementById('np-song').textContent=(t.name||'').toLowerCase();
      document.getElementById('np-artist').textContent=((t.artist&&t.artist['#text'])||'').toLowerCase();
      var imgs=t.image||[],src=imgs.length?imgs[imgs.length-1]['#text']:'';
      var art=document.getElementById('np-art');
      art.style.display=src?'':'none';
      if(src)art.src=src;
      np.href=t.url||'#';
      np.hidden=false;
    }).catch(function(){np.hidden=true});
  }
  lastfm();
  setInterval(lastfm,20000);

  /* Favorite artists + genres: both come from your Last.fm top artists. The headings and lists stay hidden until the data
     loads, so nothing flashes on refresh (and they stay hidden if Last.fm can't be reached).
     Last.fm has no "top genres" for a user, so genres are worked out from the tags on your top artists, weighted by how much you play each one. */
  var FAV_PERIOD='6month'; /* overall, 12month, 6month, 3month, 1month or 7day */
  var FAV_LIMIT=10;        /* artists shown */
  var GENRE_ARTISTS=20;    /* how many top artists are used to work out genres */
  var GENRE_LIMIT=6;       /* genres shown */
  var TAG_SKIP=/^(seen live|favou?rites?|female vocalists?|male vocalists?|american|british|canadian|australian|english|usa|uk|all|albums i own|love|sexy|beautiful|legend|awesome|cool|\d{2,4}s?)$/;
  function lf(method,extra){
    return 'https://ws.audioscrobbler.com/2.0/?method='+method+'&format=json&api_key='+encodeURIComponent(LASTFM_KEY)+extra;
  }
  function show(listId,titleId,items){
    var ul=document.getElementById(listId),frag=document.createDocumentFragment();
    items.forEach(function(t){var li=document.createElement('li');li.textContent=t;frag.appendChild(li)});
    ul.textContent='';ul.appendChild(frag);
    ul.hidden=false;document.getElementById(titleId).hidden=false;
  }
  function genres(list){
    var names=list.map(function(a){return (a.name||'').toLowerCase()});
    Promise.all(list.map(function(a){
      return fetch(lf('artist.gettoptags','&autocorrect=1&artist='+encodeURIComponent(a.name))).then(function(r){return r.json()}).catch(function(){return null});
    })).then(function(res){
      var score={};
      res.forEach(function(r,i){
        var tags=r&&r.toptags&&r.toptags.tag;
        if(!Array.isArray(tags))return;
        var w=Number(list[i].playcount)||1,used=0;
        tags.forEach(function(t){
          var n=(t.name||'').toLowerCase().trim();
          if(!n||used>=5||TAG_SKIP.test(n)||names.indexOf(n)!==-1)return;
          used++;
          score[n]=(score[n]||0)+w*(Number(t.count)||0)/100;
        });
      });
      var top=Object.keys(score).sort(function(x,y){return score[y]-score[x]}).slice(0,GENRE_LIMIT);
      if(top.length)show('fav-genres','genre-title',top);
    });
  }
  function favArtists(){
    if(LASTFM_KEY.indexOf('YOUR_')===0)return;
    fetch(lf('user.gettopartists','&period='+FAV_PERIOD+'&limit='+GENRE_ARTISTS+'&user='+encodeURIComponent(LASTFM_USER))).then(function(r){return r.json()}).then(function(j){
      var list=j.topartists&&j.topartists.artist;
      if(!Array.isArray(list)||!list.length)return;
      show('fav-artists','fav-title',list.slice(0,FAV_LIMIT).map(function(a){return (a.name||'').toLowerCase()}));
      genres(list);
    }).catch(function(){});
  }
  favArtists();
})();
</script>
